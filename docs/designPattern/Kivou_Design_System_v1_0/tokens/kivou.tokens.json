{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Kivou Design Tokens",
    "version": "1.0.0",
    "theme": "light-only MVP"
  },
  "color": {
    "primitive": {
      "deep-ink": {
        "$type": "color",
        "$value": "#0F1D18"
      },
      "warm-ivory": {
        "$type": "color",
        "$value": "#FAF6F1"
      },
      "forest-green": {
        "$type": "color",
        "$value": "#234236"
      },
      "mineral-beige": {
        "$type": "color",
        "$value": "#E7DFD3"
      },
      "terracotta": {
        "$type": "color",
        "$value": "#C56440"
      },
      "brass": {
        "$type": "color",
        "$value": "#B08D57"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFDF9"
      },
      "line": {
        "$type": "color",
        "$value": "#D9CFC2"
      },
      "success": {
        "$type": "color",
        "$value": "#2E6A50"
      },
      "warning": {
        "$type": "color",
        "$value": "#A86B2C"
      },
      "danger": {
        "$type": "color",
        "$value": "#9A4A3A"
      }
    },
    "semantic": {
      "background": {
        "canvas": {
          "$value": "{color.primitive.warm-ivory}"
        },
        "surface": {
          "$value": "{color.primitive.surface}"
        },
        "subtle": {
          "$value": "{color.primitive.mineral-beige}"
        }
      },
      "text": {
        "primary": {
          "$value": "{color.primitive.deep-ink}"
        },
        "secondary": {
          "$value": "#52605A"
        },
        "muted": {
          "$value": "#7B827E"
        },
        "inverse": {
          "$value": "#FFFFFF"
        }
      },
      "border": {
        "default": {
          "$value": "{color.primitive.line}"
        },
        "strong": {
          "$value": "#BEB3A6"
        }
      },
      "action": {
        "primary": {
          "$value": "{color.primitive.forest-green}"
        },
        "primary-hover": {
          "$value": "#19352B"
        },
        "accent": {
          "$value": "{color.primitive.brass}"
        },
        "warm": {
          "$value": "{color.primitive.terracotta}"
        }
      },
      "status": {
        "success": {
          "$value": "{color.primitive.success}"
        },
        "warning": {
          "$value": "{color.primitive.warning}"
        },
        "danger": {
          "$value": "{color.primitive.danger}"
        }
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Lora",
          "Georgia",
          "serif"
        ]
      },
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Instrument Sans",
          "Inter",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "md": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "1.875rem"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "2.25rem"
      },
      "5xl": {
        "$type": "dimension",
        "$value": "3rem"
      },
      "6xl": {
        "$type": "dimension",
        "$value": "4rem"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0.0rem"
    },
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "1.0rem"
    },
    "5": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "7": {
      "$type": "dimension",
      "$value": "1.75rem"
    },
    "8": {
      "$type": "dimension",
      "$value": "2.0rem"
    },
    "9": {
      "$type": "dimension",
      "$value": "2.25rem"
    },
    "10": {
      "$type": "dimension",
      "$value": "2.5rem"
    },
    "11": {
      "$type": "dimension",
      "$value": "2.75rem"
    },
    "12": {
      "$type": "dimension",
      "$value": "3.0rem"
    },
    "13": {
      "$type": "dimension",
      "$value": "3.25rem"
    },
    "14": {
      "$type": "dimension",
      "$value": "3.5rem"
    },
    "15": {
      "$type": "dimension",
      "$value": "3.75rem"
    },
    "16": {
      "$type": "dimension",
      "$value": "4.0rem"
    },
    "17": {
      "$type": "dimension",
      "$value": "4.25rem"
    },
    "18": {
      "$type": "dimension",
      "$value": "4.5rem"
    },
    "19": {
      "$type": "dimension",
      "$value": "4.75rem"
    },
    "20": {
      "$type": "dimension",
      "$value": "5.0rem"
    },
    "21": {
      "$type": "dimension",
      "$value": "5.25rem"
    },
    "22": {
      "$type": "dimension",
      "$value": "5.5rem"
    },
    "23": {
      "$type": "dimension",
      "$value": "5.75rem"
    },
    "24": {
      "$type": "dimension",
      "$value": "6.0rem"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0.625rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1.125rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "shadow": {
    "soft": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(15,29,24,.07)",
        "offsetX": "0",
        "offsetY": "10px",
        "blur": "30px",
        "spread": "-16px"
      }
    },
    "raised": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(15,29,24,.10)",
        "offsetX": "0",
        "offsetY": "18px",
        "blur": "48px",
        "spread": "-20px"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "base": {
        "$type": "duration",
        "$value": "180ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "260ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  },
  "breakpoint": {
    "sm": {
      "$type": "dimension",
      "$value": "640px"
    },
    "md": {
      "$type": "dimension",
      "$value": "768px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1024px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1280px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "1536px"
    }
  }
}