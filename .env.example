# Kivou — modèle de configuration.
#
# Copier en `.env` et remplir. `.env` est ignoré par Git ; ce fichier-ci est le
# SEUL de la famille à être suivi, et il ne contient que des noms de variables
# et des valeurs d'exemple.
#
#     Aucune valeur réelle ici. Jamais.
#     Une clé Stripe, un mot de passe SMTP ou une URL de base avec identifiants
#     déposés dans ce fichier partiraient sur GitHub au commit suivant.
#
# Les noms proviennent de `src/signals/api/config.py` et
# `src/signals/persistence/database.py`. Une variable absente de ce fichier est
# une variable que le code ne lit pas.

# ── Base de données ──────────────────────────────────────────────────────────
# SQLAlchemy. PostgreSQL en production, SQLite pour un essai local.
# L'URL porte des identifiants : elle ne sort jamais du gestionnaire de secrets.
KIVOU_DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@127.0.0.1:5432/kivou

# ── Ingestion DECP bornée ───────────────────────────────────────────────────
# Chaque passage finalise au plus ce nombre de journées et conserve son curseur
# après chacune. Le budget applicatif reste inférieur au timeout systemd de 25 min.
KIVOU_DECP_MAX_WINDOWS_PER_RUN=2
KIVOU_DECP_TIME_BUDGET_SECONDS=1200
KIVOU_DECP_OVERLAP_DAYS=30
# Une exécution `running` plus ancienne est terminalisée au prochain passage,
# sans suppression des faits ni des signaux déjà persistés.
KIVOU_INGESTION_STALE_RUN_SECONDS=3600

# ── Session et protection CSRF ───────────────────────────────────────────────
# L'origine EXACTE du frontend, schéma compris. Toute requête modifiante dont
# l'origine diffère est refusée. Vide = validation désactivée : acceptable en
# test uniquement, jamais en production.
KIVOU_ALLOWED_ORIGIN=https://kivou.eu

# `Secure` sur le cookie de session. Ne le relâcher qu'en local, en http://.
KIVOU_COOKIE_SECURE=1

# Durées de vie, en secondes. Absentes, les défauts s'appliquent :
# 14 jours pour la session, 1 heure pour la réinitialisation de mot de passe.
KIVOU_SESSION_TTL_SECONDS=1209600
KIVOU_PASSWORD_RESET_TTL_SECONDS=3600

# ── Stripe ───────────────────────────────────────────────────────────────────
# `test` ou `live`. Jamais déduit : une clé du mauvais mode arrête le démarrage.
KIVOU_STRIPE_MODE=test

STRIPE_SECRET_KEY=sk_test_votre_cle_de_test
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_de_webhook

# URL de retour — OBLIGATOIRES dès qu'une clé Stripe est présente.
# Sans elles, l'application refuse de démarrer plutôt que de renvoyer un client
# payant vers un domaine choisi par défaut.
STRIPE_SUCCESS_URL=https://kivou.eu/checkout/success
STRIPE_CANCEL_URL=https://kivou.eu/checkout/cancel
STRIPE_PORTAL_RETURN_URL=https://kivou.eu/app/billing

# Facultatifs.
# La fiscalité automatique est désactivée par défaut : l'activer sans
# immatriculation produirait des factures fausses.
STRIPE_AUTOMATIC_TAX_ENABLED=0
# Le coupon fondateur, attribué côté serveur et jamais réclamé par un client.
STRIPE_FOUNDING_COUPON_ID=
# La configuration de portail à appliquer. Vide = configuration par défaut du
# compte Stripe, qui sur un compte partagé afficherait la marque d'un autre
# projet.
STRIPE_PORTAL_CONFIGURATION_ID=

# ── Alertes e-mail ───────────────────────────────────────────────────────────
# Origine HTTPS publique, sans chemin. Le serveur ajoute lui-même les routes
# `/reset-password`, `/app/signals/{clé}` et `/app/notifications`.
KIVOU_PUBLIC_APP_URL=https://kivou.eu

SMTP_HOST=smtp.exemple.test
SMTP_PORT=587
SMTP_USERNAME=transactional@example.com
SMTP_PASSWORD=votre_mot_de_passe_smtp
SMTP_FROM_EMAIL=transactional@example.com
SMTP_FROM_NAME=Kivou
# `starttls` (port 587 recommandé) ou `implicit_tls` (généralement port 465).
# Aucun mode non chiffré n'est accepté.
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=30
# Facultatif, mais forcément une adresse valide lorsqu'il est défini.
SMTP_REPLY_TO_EMAIL=

# Reprise bornée des alertes. Valeurs en secondes, sauf le nombre de tentatives.
KIVOU_ALERT_LEASE_SECONDS=1800
KIVOU_ALERT_MAX_ATTEMPTS=5
KIVOU_ALERT_RETRY_BASE_SECONDS=900

# ── Instantly transport ingress (SPEC-026, disabled by default) ─────────────
# Both values are required to authenticate and bind the narrow webhook route.
# Empty values keep the route fail-closed. This does not configure a sending
# API key, mailbox, campaign worker, or provider activation capability.
KIVOU_INSTANTLY_WEBHOOK_SECRET=
KIVOU_INSTANTLY_WORKSPACE_REF=

# ── First-party attribution (SPEC-028, disabled by default) ─────────────────
# Configure both values together. The key authenticates attribution tokens; it
# does not authenticate users and grants no product access. Empty values keep
# GET /a/{token} fail-closed. Rotate by retaining prior versions in deployment
# wiring before issuing a new current version.
KIVOU_ATTRIBUTION_HMAC_KEY=
KIVOU_ATTRIBUTION_HMAC_KEY_VERSION=

# ── Internal commercial cockpit (SPEC-030, denied by default) ───────────────
# Comma-separated Kivou account references allowed to read the internal
# cockpit. Empty means that every account is denied; authorization is enforced
# by the backend and this does not create an administrator role.
KIVOU_COCKPIT_OPERATOR_ACCOUNT_IDS=

# ── Acquisition operational identity (SPEC-031, not ready by default) ───────
# Explicit deployment wiring. Values stay blank in this tracked file; protected
# staging values belong only in /etc/kivou/acquisition-shadow.env.
KIVOU_ACQUISITION_ENVIRONMENT=
KIVOU_ACQUISITION_SHADOW_CONFIG=
KIVOU_APOLLO_API_KEY=
KIVOU_INSTANTLY_API_KEY=
KIVOU_HERMES_PYTHON=
KIVOU_HERMES_HOME=
KIVOU_HERMES_CWD=
