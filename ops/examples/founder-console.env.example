# Unique Founder Console identity. This service never runs as a staging twin.
KIVOU_FOUNDER_HOSTNAME=control.kivou.eu
KIVOU_FOUNDER_ENVIRONMENT=PRODUCTION
KIVOU_FOUNDER_ALLOWED_EMAIL=rodrigue.bruppacher@gmail.com

# Generate with: openssl rand -hex 32
# Copy the same value to /etc/kivou/founder-origin-secret.conf.
KIVOU_FOUNDER_ORIGIN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Dedicated PostgreSQL role: CONNECT + USAGE + SELECT only, with
# default_transaction_read_only=on. Never reuse the application writer role.
KIVOU_FOUNDER_DATABASE_URL=postgresql+psycopg://kivou_founder_ro:REPLACE@127.0.0.1:5432/kivou
