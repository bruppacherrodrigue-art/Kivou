# Gabarit de production. Aucune valeur réelle ici.
# Aucune boîte de repli : le runtime refuse de démarrer si la variable de
# destinataire QA (voir signals/acquisition_runtime/config.py) ou sa clé HMAC
# sont seulement présentes dans l'environnement, même vides. Ne jamais ajouter
# l'une de ces deux variables staging à ce fichier.
#
# Les variables partagées avec le reste de l'application — KIVOU_DATABASE_URL,
# KIVOU_PUBLIC_APP_URL, KIVOU_ATTRIBUTION_HMAC_KEY,
# KIVOU_ATTRIBUTION_HMAC_KEY_VERSION et le paquet complet des clés webhook
# Instantly/suppression/réponse — sont déjà servies par /etc/kivou/production.env,
# chargé avant celui-ci par l'unité. Elles ne sont pas répétées ici.
#
# KIVOU_ACQUISITION_SHADOW_CONFIG conserve son nom historique en production :
# c'est la même variable, lue par le même chargeur de connectivité que le
# staging, et renommer la variable toucherait le chemin staging. Seule sa
# valeur change ici — elle désigne le document de connectivité PRODUCTION,
# distinct de celui du staging (workspace Instantly et boîtes différents).
KIVOU_ACQUISITION_ENVIRONMENT=PRODUCTION
KIVOU_ACQUISITION_RUNTIME_CONFIG=/etc/kivou/acquisition-production.json
KIVOU_ACQUISITION_SHADOW_CONFIG=/etc/kivou/acquisition-production-connectivity.json
KIVOU_APOLLO_API_KEY=
KIVOU_INSTANTLY_API_KEY=
KIVOU_HERMES_PYTHON=/opt/kivou/hermes-agent/e624e9fde561e1add9388384012b295fde669ade/.venv/bin/python
KIVOU_HERMES_HOME=/var/lib/kivou/hermes
KIVOU_HERMES_CWD=/var/lib/kivou/hermes/work
