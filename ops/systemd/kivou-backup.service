[Unit]
Description=Kivou — sauvegarde PostgreSQL
Documentation=file:/srv/kivou/app/ops/README.md
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=kivou
Group=kivou

# Le seul endroit où vit KIVOU_DATABASE_URL. Ce fichier n'est PAS dans le dépôt
# et ne doit jamais y entrer : il porte le mot de passe de la base.
EnvironmentFile=/etc/kivou/staging.env

# Le verrou est tenu par le script lui-même, et couvert par les tests. Le poser
# ici en plus ne protégerait que le chemin systemd — pas une exécution manuelle
# lancée pendant que le timer se déclenche.
ExecStart=/srv/kivou/app/ops/bin/kivou-backup.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kivou-backup

# La sauvegarde lit toute la base : elle n'a besoin d'écrire nulle part ailleurs
# que dans son propre répertoire.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/kivou/backups
