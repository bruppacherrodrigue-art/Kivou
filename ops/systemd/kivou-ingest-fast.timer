[Unit]
Description=Kivou — déclenche l'ingestion des sources rapides

[Timer]
# Toutes les deux heures, à la minute 05. Les trois groupes portent des minutes
# distinctes pour que le verrou reste une sécurité et non un mécanisme de
# cadencement quotidien.
OnCalendar=*-*-* 00/2:05:00
# Un hôte éteint rattrape au démarrage : les checkpoints étant durables, la
# reprise ne redemande que la fenêtre manquante.
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
