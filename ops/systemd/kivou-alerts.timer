# ATTENTION — n'activer cette minuterie qu'une fois SMTP configuré.
#
# Sans SMTP, le job sort en code 2 à chaque déclenchement. L'unité serait
# alors perpétuellement « failed », et la surveillance des unités en échec
# (§40) ne distinguerait plus une vraie panne d'un état attendu. Une alerte qui
# crie en permanence n'alerte plus de rien.
#
#   sudo systemctl enable --now kivou-alerts.timer   ← après configuration SMTP
[Unit]
Description=Kivou — déclenche le cycle d'alertes

[Timer]
# Toutes les heures. Assez fréquent pour que « prioritaire » ait du sens sans
# promettre du temps réel ; assez espacé pour ne pas marteler la base.
OnCalendar=hourly
# Un hôte éteint au moment prévu rattrape au démarrage plutôt que de sauter le
# cycle en silence.
Persistent=true
# Décalage aléatoire : évite que tous les timers de l'hôte partent à la seconde
# pile.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
