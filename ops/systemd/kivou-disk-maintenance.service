[Unit]
Description=Kivou staging durable disk maintenance
After=postgresql.service

[Service]
Type=oneshot
User=root
Environment=KIVOU_ENVIRONMENT=staging
EnvironmentFile=/etc/kivou/staging.env
ExecStart=/usr/local/sbin/kivou-disk-maintenance
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/kivou/releases /srv/kivou/.cache /srv/kivou/validation /var/cache/apt
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kivou-disk-maintenance
